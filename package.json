{
	"name": "lumen",
	"version": "0.1.0",
	"type": "module",
	"bin": {
		"lumen": "./bin/lumen.ts"
	},
	"scripts": {
		"start": "bun run bin/lumen.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "biome check . && bun run check:docs",
		"check:docs": "bun run scripts/check-docs.ts",
		"format": "biome format --write .",
		"build": "bun build --compile bin/lumen.ts --outfile dist/lumen"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"axi-sdk-js": "^0.1.10",
		"caelus": "0.24.1"
	}
}
